<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp"
    android:layout_gravity="center"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- صورة المكان مع ظل خفيف في الأسفل -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/img_place"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />

            <!-- طبقة تظليل خفيفة فوق الصورة لجعل النص الأبيض واضحاً إن وجد -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#26000000" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- العنوان والتقييم -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txt_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Activity Name"
                    android:textColor="#2D3436"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="⭐ 4.8"
                    android:textColor="#F1C40F"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- معلومات سريعة (Location & GPS Status) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="#008080" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="GPS Navigation Ready"
                    android:textSize="12sp"
                    android:textColor="#008080"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- الوصف -->
            <TextView
                android:id="@+id/txt_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Discover the majestic beauty of Yosemite. This trail offers panoramic views of granite cliffs and giant sequoia groves."
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="#636E72" />

            <!-- الأزرار التفاعلية -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:weightSum="2">

                <Button
                    android:id="@+id/btn_close"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text="Back"
                    android:textAllCaps="false"
                    android:backgroundTint="#DFE6E9"
                    android:textColor="#2D3436"
                    app:cornerRadius="12dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_navigate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Start GPS"
                    android:textAllCaps="false"
                    android:backgroundTint="#008080"
                    android:textColor="@color/white"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_menu_directions" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>